# Faceplica — aedificatio libphantasma.a
#
# Usus:
#   face                                       — aedifica (autodetegit platformam)
#   face CFLAGS="-Wall -Wextra -O2 -DPHANTASMA_X11"  — impera X11 in Darwin
#   face proba                                 — aedifica et curre probationem
#   face purga                                 — dele omnia aedificata
#
# Nexus: vide nexus_phantasma (generatur ab aedificatione)

CC       ?= cc
AR       ?= ar
CFLAGS   ?= -Wall -Wextra -O2

OBJECTA      = phantasma.o pfr_gif.o pfr_mp4.o
BIBLIOTHECA  = libphantasma.a

omnia: $(BIBLIOTHECA) nexus_phantasma

phantasma.o: phantasma_plat.c phantasma_darwin.m phantasma_linux.c phantasma.h
	$(CC) $(CFLAGS) `case $$(uname -s) in Darwin) echo "-x objective-c";; esac` -c phantasma_plat.c -o phantasma.o

pfr_gif.o: pfr_gif.c phantasma.h
	$(CC) $(CFLAGS) -pedantic -std=c99 -c pfr_gif.c -o pfr_gif.o

pfr_mp4.o: pfr_mp4.c phantasma.h
	$(CC) $(CFLAGS) -pedantic -std=c99 -c pfr_mp4.c -o pfr_mp4.o

$(BIBLIOTHECA): $(OBJECTA)
	$(AR) rcs $(BIBLIOTHECA) $(OBJECTA)

nexus_phantasma: $(BIBLIOTHECA)
	@if echo '$(CFLAGS)' | grep -q PHANTASMA_X11; then echo "-lX11"; \
	elif $(CC) -E -dM - </dev/null 2>/dev/null | grep -q __APPLE__; then echo "-framework Cocoa"; \
	else echo "-lX11"; fi > nexus_phantasma

proba: $(BIBLIOTHECA) nexus_phantasma proba.o
	$(CC) proba.o $(BIBLIOTHECA) `cat nexus_phantasma` -o proba

proba.o: proba.c phantasma.h
	$(CC) $(CFLAGS) -pedantic -std=c99 -c proba.c -o proba.o

proba_mp4: pfr_mp4.o proba_mp4.o
	$(CC) proba_mp4.o pfr_mp4.o -o proba_mp4

proba_mp4.o: proba_mp4.c phantasma.h
	$(CC) $(CFLAGS) -pedantic -std=c99 -c proba_mp4.c -o proba_mp4.o

proba_gif: pfr_gif.o proba_gif.o
	$(CC) proba_gif.o pfr_gif.o -lm -o proba_gif

proba_gif.o: proba_gif.c phantasma.h
	$(CC) $(CFLAGS) -pedantic -std=c99 -c proba_gif.c -o proba_gif.o

purga:
	rm -f $(OBJECTA) $(BIBLIOTHECA) nexus_phantasma proba.o proba proba_mp4.o proba_mp4 proba_gif.o proba_gif

.PHONY: omnia proba proba_mp4 proba_gif purga
