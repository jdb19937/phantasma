# Faceplica — aedificatio libphantasma.a
#
# Usus:
#   face                  — aedifica (autodetegit platformam)
#   face proba            — aedifica et curre probationem
#   face proba_computo    — aedifica et curre probationes computationis
#   face proba_mp4        — aedifica et curre probationes mp4
#   face proba_gif        — aedifica et curre probationes gif
#   face purga            — dele omnia aedificata
#
# Nexus: vide nexus_phantasma (generatur ab aedificatione)
#
# CUDA: si nvcc invenitur, computo.o ex computo_cuda.cu compilatur;
#       alioquin computo_plat.c adhibetur (Metal in Darwin, CPU in Linux).

CC      ?= cc
AR      ?= ar
CFLAGS  ?= -Wall -Wextra -O2

OBJECTA     = phantasma.o gif.o mp4.o computo.o
BIBLIOTHECA = libphantasma.a
CAPITA      = phantasma.h computo.h

omnia: $(BIBLIOTHECA) nexus_phantasma

phantasma.o: phantasma_plat.c phantasma_darwin.m phantasma_linux.c $(CAPITA)
	$(CC) $(CFLAGS) `case $$(uname -s) in Darwin) echo "-x objective-c";; esac` -c phantasma_plat.c -o phantasma.o

gif.o: gif.c $(CAPITA)
	$(CC) $(CFLAGS) -pedantic -std=c99 -c gif.c -o gif.o

mp4.o: mp4.c $(CAPITA)
	$(CC) $(CFLAGS) -pedantic -std=c99 -c mp4.c -o mp4.o

computo.o: computo_plat.c computo_metal.m computo_cpu.c computo_cuda.cu $(CAPITA)
	if which nvcc >/dev/null 2>&1; then \
	    nvcc -O2 -c computo_cuda.cu -o computo.o; \
	else \
	    $(CC) $(CFLAGS) `case $$(uname -s) in Darwin) echo "-x objective-c";; esac` -c computo_plat.c -o computo.o; \
	fi

$(BIBLIOTHECA): $(OBJECTA)
	$(AR) rcs $(BIBLIOTHECA) $(OBJECTA)

nexus_phantasma: $(BIBLIOTHECA)
	@CC='$(CC)' CFLAGS='$(CFLAGS)' sh nexus_genera.sh > nexus_phantasma

proba: $(BIBLIOTHECA) nexus_phantasma proba.o
	$(CC) proba.o $(BIBLIOTHECA) `cat nexus_phantasma` -o proba
	./proba

proba.o: proba.c $(CAPITA)
	$(CC) $(CFLAGS) -pedantic -std=c99 -c proba.c -o proba.o

proba_computo: $(BIBLIOTHECA) nexus_phantasma proba_computo.o
	$(CC) proba_computo.o $(BIBLIOTHECA) `cat nexus_phantasma` -lm -o proba_computo
	./proba_computo

proba_computo.o: proba_computo.c $(CAPITA)
	$(CC) $(CFLAGS) -pedantic -std=c99 -c proba_computo.c -o proba_computo.o

proba_mp4: mp4.o proba_mp4.o
	$(CC) proba_mp4.o mp4.o -o proba_mp4
	./proba_mp4

proba_mp4.o: proba_mp4.c $(CAPITA)
	$(CC) $(CFLAGS) -pedantic -std=c99 -c proba_mp4.c -o proba_mp4.o

proba_gif: gif.o proba_gif.o
	$(CC) proba_gif.o gif.o -lm -o proba_gif
	./proba_gif

proba_gif.o: proba_gif.c $(CAPITA)
	$(CC) $(CFLAGS) -pedantic -std=c99 -c proba_gif.c -o proba_gif.o

purga:
	rm -f $(OBJECTA) $(BIBLIOTHECA) nexus_phantasma \
	    proba.o proba proba_computo.o proba_computo \
	    proba_mp4.o proba_mp4 proba_gif.o proba_gif

.PHONY: omnia proba proba_computo proba_mp4 proba_gif purga
