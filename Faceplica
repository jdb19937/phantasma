# Faceplica — aedificatio libphantasma.a
#
# Usus:
#   face                  — aedifica (autodetegit platformam)
#   face proba            — aedifica et curre probationem
#   face proba_computo    — aedifica et curre probationes computationis
#   face proba_mp4        — aedifica et curre probationes mp4
#   face proba_gif        — aedifica et curre probationes gif
#   face proba_nn         — benchmark primitiva neuralium retium GPU vs CPU
#   face purga            — dele omnia aedificata
#
# Nexus: vide nexus_phantasma (generatur ab aedificatione)
#
# CUDA: si nvcc invenitur, computo.o ex computo_cuda.cu compilatur;
#       alioquin computo_plat.c adhibetur (Metal in Darwin, CPU in Linux).

CC      ?= cc
AR      ?= ar
CFLAGS  ?= -Wall -Wextra -O2

OBJECTA     = phantasma.o gif.o gif_lector.o quantisatio.o perturbatio.o mp4.o computo.o
BIBLIOTHECA = libphantasma.a
CAPITA      = phantasma.h computo.h quantisatio.h perturbatio.h

omnia: $(BIBLIOTHECA) nexus_phantasma gif_ad_ppm

phantasma.o: phantasma_plat.c phantasma_darwin.m phantasma_linux.c $(CAPITA)
	$(CC) $(CFLAGS) `case $$(uname -s) in Darwin) echo "-x objective-c";; esac` -c phantasma_plat.c -o phantasma.o

quantisatio.o: quantisatio.c quantisatio.h
	$(CC) $(CFLAGS) -pedantic -std=c99 -c quantisatio.c -o quantisatio.o

perturbatio.o: perturbatio.c perturbatio.h
	$(CC) $(CFLAGS) -pedantic -std=c99 -c perturbatio.c -o perturbatio.o

gif.o: gif.c quantisatio.h perturbatio.h $(CAPITA)
	$(CC) $(CFLAGS) -pedantic -std=c99 -c gif.c -o gif.o

gif_lector.o: gif_lector.c $(CAPITA)
	$(CC) $(CFLAGS) -pedantic -std=c99 -c gif_lector.c -o gif_lector.o

mp4.o: mp4.c $(CAPITA)
	$(CC) $(CFLAGS) -pedantic -std=c99 -c mp4.c -o mp4.o

computo.o: computo_plat.c computo_metal.m computo_cpu.c computo_cuda.cu $(CAPITA)
	if which nvcc >/dev/null 2>&1; then \
	    nvcc -O2 -c computo_cuda.cu -o computo.o; \
	else \
	    $(CC) $(CFLAGS) `case $$(uname -s) in Darwin) echo "-x objective-c";; esac` -c computo_plat.c -o computo.o; \
	fi

$(BIBLIOTHECA): $(OBJECTA)
	$(AR) rcs $(BIBLIOTHECA) $(OBJECTA)

nexus_phantasma: $(BIBLIOTHECA)
	@CC='$(CC)' CFLAGS='$(CFLAGS)' sh nexus_genera.sh > nexus_phantasma

proba: proba_prima proba_computo proba_mp4 proba_gif proba_nn
	./proba_prima
	./proba_computo
	./proba_mp4
	./proba_gif
	./proba_nn

proba_prima: $(BIBLIOTHECA) nexus_phantasma proba_prima.o
	$(CC) proba_prima.o $(BIBLIOTHECA) `cat nexus_phantasma` -o proba_prima
proba_prima.o: proba_prima.c $(CAPITA)
	$(CC) $(CFLAGS) -pedantic -std=c99 -c proba_prima.c -o proba_prima.o

proba_computo: $(BIBLIOTHECA) nexus_phantasma proba_computo.o
	$(CC) proba_computo.o $(BIBLIOTHECA) `cat nexus_phantasma` -lm -o proba_computo
proba_computo.o: proba_computo.c $(CAPITA)
	$(CC) $(CFLAGS) -pedantic -std=c99 -c proba_computo.c -o proba_computo.o

proba_mp4: mp4.o proba_mp4.o
	$(CC) proba_mp4.o mp4.o -o proba_mp4
proba_mp4.o: proba_mp4.c $(CAPITA)
	$(CC) $(CFLAGS) -pedantic -std=c99 -c proba_mp4.c -o proba_mp4.o

proba_gif: gif.o gif_lector.o quantisatio.o perturbatio.o proba_gif.o
	$(CC) proba_gif.o gif.o gif_lector.o quantisatio.o perturbatio.o -lm -o proba_gif
proba_gif.o: proba_gif.c $(CAPITA)
	$(CC) $(CFLAGS) -pedantic -std=c99 -c proba_gif.c -o proba_gif.o

gif_ad_ppm: gif_lector.o gif_ad_ppm.o
	$(CC) gif_ad_ppm.o gif_lector.o -o gif_ad_ppm
gif_ad_ppm.o: gif_ad_ppm.c $(CAPITA)
	$(CC) $(CFLAGS) -pedantic -std=c99 -c gif_ad_ppm.c -o gif_ad_ppm.o

proba_nn: $(BIBLIOTHECA) nexus_phantasma proba_nn.o
	$(CC) proba_nn.o $(BIBLIOTHECA) `cat nexus_phantasma` -lm -o proba_nn
proba_nn.o: proba_nn.c $(CAPITA)
	$(CC) $(CFLAGS) -pedantic -std=c99 -c proba_nn.c -o proba_nn.o

PREFIX = /opt/apotheca

colloca: omnia
	install -d $(PREFIX)/lib $(PREFIX)/include/phantasma $(PREFIX)/bin
	install -m 644 $(BIBLIOTHECA) $(PREFIX)/lib/
	install -m 644 nexus_phantasma $(PREFIX)/lib/
	install -m 644 phantasma.h computo.h quantisatio.h perturbatio.h $(PREFIX)/include/phantasma/
	install -m 755 gif_ad_ppm $(PREFIX)/bin/

purga:
	rm -f $(OBJECTA) $(BIBLIOTHECA) nexus_phantasma \
	    proba_prima.o proba_prima proba_computo.o proba_computo \
	    proba_mp4.o proba_mp4 proba_gif.o proba_gif \
	    proba_nn.o proba_nn \
	    gif_ad_ppm.o gif_ad_ppm \
	    quantisatio.o perturbatio.o

linte:
	insinulint -c *.c *.h

.PHONY: omnia colloca proba purga linte
