# Faceplica.linux — aedificatio libphantasma.a (Linux)
#
# Usus:
#   face -f Faceplica.linux            — aedifica libphantasma.a
#   face -f Faceplica.linux purga      — dele omnia aedificata
#
# Nexus: -lX11

CC       ?= cc
AR       ?= ar
CFLAGS   ?= -Wall -Wextra -pedantic -std=c99 -O2

FONTES       = phantasma_linux.c pfr_gif.c pfr_mp4.c
OBJECTA      = phantasma.o pfr_gif.o pfr_mp4.o
BIBLIOTHECA  = libphantasma.a

omnia: $(BIBLIOTHECA)

phantasma.o: phantasma_linux.c phantasma.h
	$(CC) $(CFLAGS) -c phantasma_linux.c -o phantasma.o

pfr_gif.o: pfr_gif.c phantasma.h
	$(CC) $(CFLAGS) -c pfr_gif.c -o pfr_gif.o

pfr_mp4.o: pfr_mp4.c phantasma.h
	$(CC) $(CFLAGS) -c pfr_mp4.c -o pfr_mp4.o

$(BIBLIOTHECA): $(OBJECTA)
	$(AR) rcs $(BIBLIOTHECA) $(OBJECTA)

purga:
	rm -f $(OBJECTA) $(BIBLIOTHECA)

.PHONY: omnia purga
